# Normalize source and documentation to LF.
.gitattributes text eol=lf
.gitignore text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.cc text eol=lf
*.hh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.qml text eol=lf
*.qrc text eol=lf
*.ui text eol=lf
*.cmake text eol=lf
*.service text eol=lf
*.sh text eol=lf
Caddyfile text eol=lf
CMakeLists.txt text eol=lf
*.s text eol=lf
*.ioc text eol=lf

# Keep Windows-facing scripts on CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
