static HAL_StatusTypeDef WeatherADC_CalibrateIfNeeded(void)
{
  if (s_weather_adc_calibrated != 0U)
  {
    return HAL_OK;
  }

  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_CALIB_OFFSET_LINEARITY, ADC_SINGLE_ENDED) != HAL_OK)
  {
    s_weather_adc_cal_warn = 1U;
  }

  s_weather_adc_calibrated = 1U;
  HAL_Delay(1U);
  return HAL_OK;
}

static HAL_StatusTypeDef WeatherADC_ConfigSingleMode(void)
{
  ADC_MultiModeTypeDef multimode = {0};

  (void)HAL_ADC_DeInit(&hadc1);
  s_weather_adc_calibrated = 0U;
  hadc1.Instance = ADC1;
  hadc1.Init.ClockPrescaler = ADC_CLOCK_ASYNC_DIV2;
  hadc1.Init.Resolution = ADC_RESOLUTION_16B;
  hadc1.Init.ScanConvMode = ADC_SCAN_DISABLE;
  hadc1.Init.EOCSelection = ADC_EOC_SINGLE_CONV;
  hadc1.Init.LowPowerAutoWait = DISABLE;
  hadc1.Init.ContinuousConvMode = DISABLE;
  hadc1.Init.NbrOfConversion = 1;
  hadc1.Init.DiscontinuousConvMode = DISABLE;
  hadc1.Init.ExternalTrigConv = ADC_SOFTWARE_START;
  hadc1.Init.ExternalTrigConvEdge = ADC_EXTERNALTRIGCONVEDGE_NONE;
  hadc1.Init.ConversionDataManagement = ADC_CONVERSIONDATA_DR;
  hadc1.Init.Overrun = ADC_OVR_DATA_PRESERVED;
  hadc1.Init.LeftBitShift = ADC_LEFTBITSHIFT_NONE;
  hadc1.Init.OversamplingMode = DISABLE;
  hadc1.Init.Oversampling.Ratio = 1;

  if (HAL_ADC_Init(&hadc1) != HAL_OK)
  {
    return HAL_ERROR;
  }

  multimode.Mode = ADC_MODE_INDEPENDENT;
  if (HAL_ADCEx_MultiModeConfigChannel(&hadc1, &multimode) != HAL_OK)
  {
    return HAL_ERROR;
  }

  return HAL_OK;
}

static HAL_StatusTypeDef WeatherADC_ReadSingle(uint32_t channel, uint16_t *value_out)
{
  ADC_ChannelConfTypeDef sConfig = {0};

  if (value_out == NULL)
  {
    return HAL_ERROR;
  }

  if (WeatherADC_CalibrateIfNeeded() != HAL_OK)
  {
    return HAL_ERROR;
  }

  (void)HAL_ADC_Stop_DMA(&hadc1);
  (void)HAL_ADC_Stop(&hadc1);

  sConfig.Channel = channel;
  sConfig.Rank = ADC_REGULAR_RANK_1;
  sConfig.SamplingTime = ADC_SAMPLETIME_64CYCLES_5;
  sConfig.SingleDiff = ADC_SINGLE_ENDED;
  sConfig.OffsetNumber = ADC_OFFSET_NONE;
  sConfig.Offset = 0;
  sConfig.OffsetSignedSaturation = DISABLE;

  if (HAL_ADC_ConfigChannel(&hadc1, &sConfig) != HAL_OK)
  {
    return HAL_ERROR;
  }

  if (HAL_ADC_Start(&hadc1) != HAL_OK)
  {
    return HAL_ERROR;
  }

  if (HAL_ADC_PollForConversion(&hadc1, 100U) != HAL_OK)
  {
    (void)HAL_ADC_Stop(&hadc1);
    return HAL_ERROR;
  }

  *value_out = (uint16_t)HAL_ADC_GetValue(&hadc1);
  (void)HAL_ADC_Stop(&hadc1);
  return HAL_OK;
}

HAL_StatusTypeDef WeatherADC_Start(void)
{
  (void)HAL_ADC_Stop_DMA(&hadc1);
  (void)HAL_ADC_Stop(&hadc1);
  s_weather_adc_single_ready = 0U;
  s_weather_adc_calibrated = 0U;
  s_weather_adc_cal_warn = 0U;

  MX_ADC1_Init();

  if (WeatherADC_CalibrateIfNeeded() != HAL_OK)
  {
    WeatherADC_SetModeText("FAIL");
    return HAL_ERROR;
  }

  if (HAL_ADC_Start_DMA(&hadc1, (uint32_t *)g_weather_adc_raw, 3U) != HAL_OK)
  {
    WeatherADC_SetModeText("FAIL");
    return HAL_ERROR;
  }

  WeatherADC_SetModeText("DMA");
  return HAL_OK;
}

HAL_StatusTypeDef WeatherADC_RefreshFallback(void)
{
  uint16_t speed_raw = 0U;
  uint16_t direction_raw = 0U;
  uint16_t rain_raw = 0U;

  if (s_weather_adc_single_ready == 0U)
  {
    (void)HAL_ADC_Stop_DMA(&hadc1);
    (void)HAL_ADC_Stop(&hadc1);
    if (WeatherADC_ConfigSingleMode() != HAL_OK)
    {
      WeatherADC_SetModeText("F_INIT");
      return HAL_ERROR;
    }

    s_weather_adc_single_ready = 1U;
  }

  if (WeatherADC_ReadSingle(ADC_CHANNEL_3, &speed_raw) != HAL_OK)
  {
    WeatherADC_SetModeText("C3_ERR");
    return HAL_ERROR;
  }

  if (WeatherADC_ReadSingle(ADC_CHANNEL_4, &direction_raw) != HAL_OK)
  {
    WeatherADC_SetModeText("C4_ERR");
    return HAL_ERROR;
  }

  if (WeatherADC_ReadSingle(ADC_CHANNEL_8, &rain_raw) != HAL_OK)
  {
    WeatherADC_SetModeText("C8_ERR");
    return HAL_ERROR;
  }

  g_weather_adc_raw[0] = speed_raw;
  g_weather_adc_raw[1] = direction_raw;
  g_weather_adc_raw[2] = rain_raw;
  WeatherADC_SetModeText((s_weather_adc_cal_warn != 0U) ? "P_NOCAL" : "POLLING");
  return HAL_OK;
}

uint16_t WeatherADC_ReadRaw(uint32_t index)
{
  if (index >= 3U)
  {
    return 0U;
  }

  return g_weather_adc_raw[index];
}

/* USER CODE END 1 */

