# Copy to deploy/linux/.env on the server. Do not commit the populated file.
QXZ_API_HOST=0.0.0.0
QXZ_API_PORT=8000
QXZ_PUBLIC_API_BASE=https://edge.qixiangzhan.online/api/v1
QXZ_DATABASE_URL=sqlite:////data/qixiangzhan.db

QXZ_MQTT_HOST=rc11adc1.ala.cn-hangzhou.emqxsl.cn
QXZ_MQTT_PORT=8883
QXZ_MQTT_USERNAME=h743
QXZ_MQTT_PASSWORD=replace-with-emqx-password
QXZ_MQTT_USE_TLS=true
QXZ_MQTT_KEEPALIVE=60

QXZ_ADMIN_USERNAME=admin
QXZ_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
QXZ_ADMIN_DISPLAY_NAME=Platform Admin
QXZ_TOKEN_SECRET=replace-with-a-long-random-token-secret
QXZ_TOKEN_ISSUER=qixiangzhan-backend
QXZ_ACCESS_TOKEN_MINUTES=15
QXZ_REFRESH_TOKEN_DAYS=30
QXZ_OFFLINE_SECONDS=90
QXZ_ACK_TIMEOUT_SECONDS=15
QXZ_WS_HEARTBEAT_SECONDS=20

QXZ_EDGE_DEVICE_KEY=replace-with-a-long-random-edge-key
QXZ_LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QXZ_LLM_API_KEY=replace-with-model-provider-key
QXZ_LLM_MODEL=qwen-plus
QXZ_LLM_TIMEOUT_SECONDS=20
QXZ_LLM_DEVICE_COOLDOWN_SECONDS=20

QXZ_FORECAST_EDGE_KEY=replace-with-a-different-long-random-forecast-key
QXZ_FORECAST_CACHE_SECONDS=1800
QXZ_FORECAST_TIMEOUT_SECONDS=12
QXZ_JSON_LOGS=false
