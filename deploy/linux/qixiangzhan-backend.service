[Unit]
Description=qixiangzhan FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/qixiangzhan/backend
EnvironmentFile=/opt/qixiangzhan/backend/.env
ExecStart=/opt/qixiangzhan/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
