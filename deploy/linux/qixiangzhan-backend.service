[Unit]
Description=qixiangzhan FastAPI backend
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=simple
User=qixiangzhan
Group=qixiangzhan
WorkingDirectory=/opt/qixiangzhan/backend
EnvironmentFile=/opt/qixiangzhan/backend/.env
ExecStartPre=/opt/qixiangzhan/backend/.venv/bin/python -m alembic -c alembic.ini upgrade head
ExecStart=/opt/qixiangzhan/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
