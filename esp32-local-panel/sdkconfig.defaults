# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.2.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Seven LVGL pages are assembled synchronously from app_main. The ESP-IDF
# default 3584-byte main task stack overflows during that one-time assembly.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_RODATA=y
# The Waveshare ESP32-S3-Touch-LCD-7 reference project uses 80 MHz octal
# PSRAM. RGB DMA fetches a complete 800x480 frame continuously, so 40 MHz
# leaves too little headroom once Wi-Fi is active and can cause RGB underflow.
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_EXAMPLE_LVGL_PORT_TASK_CORE=1
CONFIG_EXAMPLE_LVGL_PORT_TASK_STACK_SIZE_KB=10
# Render directly into a pair of PSRAM RGB frame buffers. This is the
# Waveshare reference configuration and avoids a large PSRAM-to-framebuffer
# copy on each LVGL flush.
CONFIG_EXAMPLE_LVGL_PORT_AVOID_TEAR_ENABLE=y
CONFIG_EXAMPLE_LVGL_PORT_AVOID_TEAR_MODE_3=y

CONFIG_LV_COLOR_SCREEN_TRANSP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_MEMCPY_MEMSET_STD=y
# CONFIG_LV_USE_LOG is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
# CONFIG_LV_SPRINTF_USE_FLOAT is not set
CONFIG_LV_USE_FONT_COMPRESSED=y
# CONFIG_LV_USE_IMGFONT is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_USE_DEMO_WIDGETS is not set
# CONFIG_LV_USE_DEMO_BENCHMARK is not set
# CONFIG_LV_USE_DEMO_STRESS is not set
# CONFIG_LV_USE_DEMO_MUSIC is not set
CONFIG_EXAMPLE_LVGL_PORT_TICK=5

CONFIG_PANEL_RS485_UART_NUM=1
CONFIG_PANEL_RS485_TX_GPIO=16
CONFIG_PANEL_RS485_RX_GPIO=15
CONFIG_PANEL_RS485_BAUD_RATE=4800
CONFIG_PANEL_RS485_RX_BUFFER_SIZE=512
CONFIG_PANEL_RS485_TX_BUFFER_SIZE=256
CONFIG_PANEL_LINK_OFFLINE_TIMEOUT_MS=3000

CONFIG_PANEL_WIFI_SSID=""
CONFIG_PANEL_WIFI_PASSWORD=""
CONFIG_PANEL_EDGE_API_URL="https://edge.qixiangzhan.online/api/v1/edge/ai/analyze"
CONFIG_PANEL_EDGE_DEVICE_ID="relay_h743_001"
CONFIG_PANEL_EDGE_KEY=""
CONFIG_PANEL_LLM_MODEL="qwen3.7-plus"
CONFIG_PANEL_ADMIN_PIN="123456"
CONFIG_PANEL_AI_AUTO_INTERVAL_SECONDS=60
CONFIG_PANEL_AI_HTTP_TIMEOUT_MS=30000
CONFIG_PANEL_FORECAST_API_URL="https://edge.qixiangzhan.online/api/v1/edge/weather/forecast"
CONFIG_PANEL_FORECAST_KEY="4e3e305d00afffcb859d197a24915f83c7c5e73e291c9ada6b769f0d1d75e9a8"
CONFIG_PANEL_FORECAST_LOCATION_NAME=""
CONFIG_PANEL_FORECAST_LATITUDE=""
CONFIG_PANEL_FORECAST_LONGITUDE=""
CONFIG_PANEL_FORECAST_TIMEZONE="Asia/Shanghai"
CONFIG_PANEL_FORECAST_REFRESH_SECONDS=1800
